{
    "name": "mageenv/module-e-invoice-hyva",
    "description": "Hyva storefront templates for MageEnv XRechnung & ZUGFeRD E-Invoicing: e-invoice downloads on the customer's invoice and credit memo pages and the B2B e-invoice settings in the customer account, for Hyva themes. No business logic.",
    "type": "magento2-module",
    "license": [
        "OSL-3.0"
    ],
    "homepage": "https://mageenv.com/extensions/",
    "support": {
        "issues": "https://github.com/mageenvm2/module-e-invoice-hyva/issues",
        "source": "https://github.com/mageenvm2/module-e-invoice-hyva",
        "email": "info@mageenv.com"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": ">=103.0.7 <104",
        "mageenv/module-e-invoice": "^1.0.0",
        "hyva-themes/magento2-theme-module": ">=1.1.0 <2"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MageEnv\\EInvoiceHyva\\": ""
        }
    },
    "archive": {
        "exclude": [
            "/Test",
            "/phpcs.xml.dist",
            "/.gitignore"
        ]
    }
}
